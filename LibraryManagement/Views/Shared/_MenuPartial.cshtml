@model IEnumerable<LibraryManagement.ViewModels.NavigationMenuViewModel>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<nav class="navbar">
    <ul class="nav ms-auto">
        @foreach (var item in Model.Where(m => m.Name != "My Account"))
        {
            @await Html.PartialAsync("_RecursiveMenuPartial", item)
        }

        @{
            var myAccountItem = Model.FirstOrDefault(item => item.Name == "My Account");
        }
        @if (myAccountItem != null)
        {
            @await Html.PartialAsync("_RecursiveMenuPartial", myAccountItem)
        }
    </ul>
</nav>
