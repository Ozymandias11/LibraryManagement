<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-primary" style="border-width: 5px; border-radius: 30px; background-color: #FCF7FF;">
                <div class="card-body">
                    <h2 class="text-primary text-center mb-4">Generate Library Report</h2>
                    <form id="reportForm">
                        <div id="errorMessage" class="alert alert-danger" style="display: none;"></div>
                        <div class="form-group">
                            <label for="yearInput" class="control-label text-primary mb-2">Enter Year:</label>
                            <input type="number" id="yearInput" name="year" class="form-control form-control-lg" required min="1900" max="2100">
                        </div>
                        <div class="form-group text-center mt-5">
                            <button type="submit" class="btn btn-primary btn-block btn-lg">Generate Report</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Reports/rdlc-report.js"></script>
}